# =============================================================================
# AI Advertising Engine — environment configuration
# =============================================================================
# Copy to `.env` and fill in. Never commit a real `.env`.
# Every variable below is validated at boot by src/lib/env.ts — the app refuses
# to start with a missing or malformed required value rather than failing later.
#
# Variables are grouped by the development phase that first needs them.
# Anything marked OPTIONAL can be left unset; the relevant subsystem then runs
# in mock mode or stays disabled.
# =============================================================================

# ---------------------------------------------------------------------------
# PHASE 1 — core runtime (REQUIRED)
# ---------------------------------------------------------------------------

NODE_ENV=development

# Absolute, public base URL of this deployment. Used to build OAuth redirect
# URIs and absolute links. No trailing slash.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://adsdev:adsdev@127.0.0.1:5432/ads_pipeline_dev

# 32+ byte random secret used to derive session-token hashes.
#   openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-characters-of-random-data

# AES-256-GCM key for encrypting third-party OAuth tokens at rest.
# Exactly 32 bytes, base64-encoded:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-base64-encoded-32-byte-key====

# trace | debug | info | warn | error
LOG_LEVEL=info

# json | pretty  (pretty is for local terminals only)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# PHASE 1 — mock mode (OPTIONAL)
# ---------------------------------------------------------------------------
# When true, every external provider (AI, image generation, advertising
# platforms, and the website scanner's network layer) resolves to a
# deterministic in-process fake. This is the default outside production and is
# how the whole pipeline is developed and tested without credentials or ad spend.
MOCK_MODE=true

# ---------------------------------------------------------------------------
# PHASE 2 — website scanner (OPTIONAL, defaults shown)
# ---------------------------------------------------------------------------
# User-Agent the crawler identifies itself with. Keep it honest and contactable.
# CRAWLER_USER_AGENT="AdsPipelineBot/0.1 (+https://example.com/bot)"
# Minimum milliseconds between requests to the same host.
# CRAWLER_MIN_DELAY_MS=1000
# Hard ceiling on pages fetched per scan.
# CRAWLER_MAX_PAGES=200
# Per-request timeout.
# CRAWLER_TIMEOUT_MS=15000
# Max response body accepted, in bytes.
# CRAWLER_MAX_BYTES=5000000

# ---------------------------------------------------------------------------
# PHASE 3 — AI provider (OPTIONAL; ignored while MOCK_MODE=true)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# PHASE 4 — image generation + object storage (OPTIONAL)
# ---------------------------------------------------------------------------
# IMAGE_PROVIDER=mock
# IMAGE_PROVIDER_API_KEY=
# STORAGE_DRIVER=local          # local | s3
# STORAGE_LOCAL_PATH=.storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# PHASE 6 — Meta Marketing API (OPTIONAL; ignored while MOCK_MODE=true)
# ---------------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v21.0
# Shared secret used to verify inbound Meta webhook signatures.
# META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# PHASE 5/10 — spending safeguards (OPTIONAL; these are the platform-wide
# ceilings, applied on top of each business's own configured limits)
# ---------------------------------------------------------------------------
# Hard cap on any single campaign's daily budget, in minor units (cents).
# MAX_DAILY_BUDGET_CENTS=2000
# Hard cap on any single campaign's lifetime budget, in minor units (cents).
# MAX_CAMPAIGN_BUDGET_CENTS=10000
# Daily budget above which explicit human approval is always required (cents).
# BUDGET_APPROVAL_THRESHOLD_CENTS=5000
