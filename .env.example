# =============================================================================
# AI Advertising Engine — environment configuration
# =============================================================================
# Copy to `.env` and fill in the four REQUIRED values. Everything else has a
# working default. Never commit a real `.env`.
#
# This application is built to run at $0. Out of the box it needs a local
# PostgreSQL and nothing else — no API keys, no hosted services, no credit
# card. Every external service below is an optional upgrade.
#
# Every variable is validated at boot by src/lib/env.ts. The app refuses to
# start on a missing or malformed required value rather than failing later.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — four values, all local
# -----------------------------------------------------------------------------

NODE_ENV=development

# Public base URL of this deployment. No trailing slash.
APP_URL=http://localhost:3000

# Local PostgreSQL. Free, and the only service the application requires.
DATABASE_URL=postgresql://adsdev:adsdev@127.0.0.1:5432/ads_pipeline_dev

# Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-characters-of-random-data

# Generate with:  openssl rand -base64 32     (must decode to exactly 32 bytes)
ENCRYPTION_KEY=replace-me-with-a-base64-encoded-32-byte-key====

# -----------------------------------------------------------------------------
# ZERO-COST MODE — the master switch
# -----------------------------------------------------------------------------
# ON (the default). Every capability — AI, image generation, advertising,
# storage, analytics — resolves to a local or simulated implementation. No
# paid provider can be reached, no money can be spent, and the entire
# advertising pipeline runs end to end for free.
#
# This is not a degraded mode. It is the mode the product is developed,
# tested and demonstrated in. Turning it off is a deliberate act, and even
# then each external provider stays disabled until you enable it explicitly.
ZERO_COST_MODE=true

# -----------------------------------------------------------------------------
# PUBLIC DEPLOYMENT — required once a domain points at this
# -----------------------------------------------------------------------------
# None of this is needed for local work. All of it matters the moment the app
# is reachable from the internet.

# Which reverse proxy sits in front: none | cloudflare | vercel
#
# Decides which header the real client IP is read from, and it is
# configuration rather than detection on purpose: anybody can send an
# X-Forwarded-For, so trusting it unconditionally would let one caller defeat
# per-IP rate limiting by rotating a header value. `none` reads no proxy
# header at all, which means every anonymous caller shares one bucket — safe,
# but blunt. Set it to match reality.
TRUSTED_PROXY=none

# Shared secret authorising /api/cron/worker, the endpoint that drains the job
# queue. REQUIRED in production: with no always-on worker process and no
# secret, a queued scan is never picked up and the app looks broken.
#   openssl rand -base64 32
# CRON_SECRET=

# How long one worker invocation may spend before returning (ms).
#
# Must sit below the platform's function timeout on a serverless host. Set too
# high, the invocation is killed mid-crawl and the whole attempt is repeated;
# set correctly, a long crawl stops itself and reports PARTIAL with the pages
# it did read. Irrelevant when running `npm run worker` on a real process.
# WORKER_MAX_RUN_MS=240000

# -----------------------------------------------------------------------------
# LOGGING (optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# json | pretty  (pretty is for local terminals)
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# INFRASTRUCTURE COST CEILINGS (optional)
# -----------------------------------------------------------------------------
# What the platform may spend on metered APIs — AI tokens, image generation.
# This is NOT advertising spend; that is separate, below.
#
# The defaults are ZERO. Nothing paid runs until you raise these AND turn off
# ZERO_COST_MODE AND enable a specific provider. Three deliberate steps, so no
# configuration slip can start a bill.
#
# Zero means zero here, never "unlimited".
# MAX_DAILY_PROVIDER_COST_CENTS=0
# MAX_MONTHLY_PROVIDER_COST_CENTS=0
# Ceiling for any single call, so one runaway request cannot drain the day.
# MAX_SINGLE_CALL_COST_CENTS=50

# -----------------------------------------------------------------------------
# ADVERTISING SPENDING CEILINGS (optional)
# -----------------------------------------------------------------------------
# Money spent on ads. Always intersected with each business's own stated
# budget — the lower of the two wins, and no automation level can raise them.
# MAX_DAILY_BUDGET_CENTS=2000
# MAX_CAMPAIGN_BUDGET_CENTS=10000
# BUDGET_APPROVAL_THRESHOLD_CENTS=5000

# -----------------------------------------------------------------------------
# WEBSITE SCANNER (optional; free — it fetches public pages)
# -----------------------------------------------------------------------------
# CRAWLER_USER_AGENT="AdsPipelineBot/0.1 (+https://example.com/bot)"
# CRAWLER_MIN_DELAY_MS=1000      # minimum gap between requests to one host
# CRAWLER_MAX_PAGES=200
# CRAWLER_TIMEOUT_MS=15000
# CRAWLER_MAX_BYTES=5000000

# -----------------------------------------------------------------------------
# STORAGE (optional)
# -----------------------------------------------------------------------------
# Local filesystem storage is the default and is free.
# STORAGE_LOCAL_PATH=.storage
#
# S3-compatible storage is an optional upgrade. Set all four together or none;
# leaving them unset keeps free local storage. Works with any S3-compatible
# endpoint, including self-hosted MinIO, which is also free.
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# =============================================================================
# OPTIONAL EXTERNAL PROVIDERS — all PAID, all off by default
# =============================================================================
# Setting a key here does NOT start spending. It only makes a provider
# available to be enabled. It still needs ZERO_COST_MODE=false, a non-zero
# cost ceiling, and the provider switched on in Settings before a single
# paid call can happen.
# -----------------------------------------------------------------------------

# AI — used for business analysis, strategy, and ad copy.
# Without it, the local provider produces deterministic simulated output.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Image generation — used for ad creatives.
# Without it, creatives are rendered locally from templates. Also free.
# IMAGE_PROVIDER_API_KEY=

# Meta Marketing API — used to publish real campaigns that spend real money.
# Without it, campaigns are simulated: full structure, simulated performance,
# no ads served and no spend.
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v21.0
# META_WEBHOOK_VERIFY_TOKEN=
