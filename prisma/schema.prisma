// =============================================================================
// AI Advertising Engine — database schema
// =============================================================================
// Scope: PHASE 1 only (identity, tenancy, auditing, background jobs).
//
// The full target schema — Website, Product, BusinessFact, MarketingStrategy,
// Offer, Creative, Campaign, Experiment, PerformanceSnapshot and the rest — is
// specified in docs/SCHEMA.md and lands phase by phase. Tables are added when
// the code that reads and writes them is added, so that every migration ships
// with the behaviour that justifies it.
//
// Conventions
//  - Every tenant-scoped table carries `businessId` (or `workspaceId` one level
//    up) as a non-null FK, indexed. Isolation is enforced in the data-access
//    layer (src/server/tenancy) and asserted by tests in tests/db.
//  - Money is stored in integer minor units (cents) with an ISO-4217 currency
//    code. No floats anywhere near a budget.
//  - Deletes cascade down the ownership tree; nothing tenant-scoped is orphaned.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  /// scrypt-derived; see src/server/auth/password.ts for the encoded format.
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  memberships WorkspaceMembership[]
  auditLogs   AuditLog[]

  @@index([createdAt])
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 of the session token, keyed with AUTH_SECRET. The raw token lives
  /// only in the user's cookie — a database dump does not yield live sessions.
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Recorded for the security audit trail, not for tracking.
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

/// The billing and ownership boundary. A workspace owns many businesses; a user
/// may belong to several workspaces.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  /// Human-readable, URL-safe, globally unique.
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      WorkspaceMembership[]
  businesses       Business[]
  auditLogs        AuditLog[]
  jobs             Job[]
  providerSettings ProviderSetting[]
  costRecords      CostRecord[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

/// How much the platform may do without a human pressing the button.
///
/// Three choices, not a matrix of thresholds. The business owner picks one
/// sentence about how much they want to be involved; every internal safeguard
/// — budget caps, QA gates, claim checks, experiment stopping rules — applies
/// identically at all three levels and is never something they configure.
enum AutomationMode {
  /// The AI plans, creates, launches and optimises within the stated budget.
  /// It still stops and asks whenever something important is uncertain.
  AUTOPILOT
  /// The AI prepares everything and asks before anything goes live or
  /// anything starts spending.
  ASK_ME_FIRST
  /// The AI creates recommendations and creatives; the owner approves each
  /// action individually.
  MANUAL
}

/// What the business owner is actually trying to achieve, in their words.
/// Mapped internally to platform campaign objectives — the owner never sees
/// "CONVERSIONS" or "OUTCOME_SALES".
enum BusinessGoal {
  /// "Get more sales"
  SALES
  /// "Get more leads"
  LEADS
  /// "Get more customers"
  CUSTOMERS
  /// "Grow awareness"
  AWARENESS
}

/// How the owner expressed their budget. Stored as entered so the UI can show
/// it back in their own terms; the daily figure the system actually spends
/// against is derived (see src/lib/budget.ts).
enum BudgetPeriod {
  DAILY
  MONTHLY
}

/// One advertised business. This is the tenant boundary for all campaign data:
/// knowledge, creatives, campaigns and learning never cross it.
model Business {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  /// Free text, not an enum: the platform must accept industries nobody
  /// anticipated when this table was written.
  industry    String?
  websiteUrl  String?
  description String?
  /// ISO 4217. All money on this business is denominated in it.
  currency    String  @default("USD")
  /// IANA timezone, used for scheduling and for day-boundary reporting.
  timezone    String  @default("UTC")

  // --- The four things the owner actually chooses -------------------------
  // Everything else about how this business is advertised is decided by the
  // system. Null goal/budget means onboarding has not finished yet.

  /// Step 2 of onboarding.
  goal BusinessGoal?

  /// Step 3. Stored exactly as entered — "$10/day" or "$300/month" — so it can
  /// be shown back in the owner's own words.
  budgetAmountCents Int?
  budgetPeriod      BudgetPeriod?

  /// Step 4.
  automationMode AutomationMode @default(ASK_ME_FIRST)

  /// Set by the PAUSE EVERYTHING control. While non-null nothing launches,
  /// nothing spends, and no automation runs for this business.
  pausedAt    DateTime?
  /// Why it paused: a person pressed the button, or a safeguard tripped.
  pauseReason String?

  // --- Internal safeguards, not owner-facing -------------------------------
  // Intersected with the platform-wide ceilings from env; the lower wins.
  // Derived from the stated budget at onboarding, not typed in by the owner.
  maxDailyBudgetCents          Int @default(2000)
  maxCampaignBudgetCents       Int @default(10000)
  budgetApprovalThresholdCents Int @default(5000)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  auditLogs      AuditLog[]
  jobs           Job[]
  activityEvents ActivityEvent[]
  costRecords    CostRecord[]
  websites       Website[]
  scanRuns       ScanRun[]
  websitePages   WebsitePage[]
  products       Product[]
  businessFacts  BusinessFact[]

  // Phase 3 — the marketing engine
  profile     BusinessProfile?
  inferences  AiInference[]
  strategies  MarketingStrategy[]
  offers      Offer[]
  offerRules  OfferRules?
  adCopies    AdCopy[]
  aiDecisions AiDecision[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("businesses")
}

// -----------------------------------------------------------------------------
// Auditing
// -----------------------------------------------------------------------------

/// Who did what, and whether "who" was a person or the AI. Append-only:
/// nothing in the application updates or deletes these rows.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessId  String?   @db.Uuid
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  actorType AuditActorType
  /// Null when the actor is the system or the AI.
  actorId   String?        @db.Uuid
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Dotted verb, e.g. `business.created`, `campaign.launched`.
  action     String
  /// The model name of the affected record, e.g. `Business`.
  objectType String?
  objectId   String?

  /// Prior and resulting state for the fields that changed. Redacted before write.
  previousValue Json?
  newValue      Json?
  metadata      Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([businessId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum AuditActorType {
  USER
  SYSTEM
  AI
}

// -----------------------------------------------------------------------------
// Background jobs
// -----------------------------------------------------------------------------
// A database-backed queue. Postgres `FOR UPDATE SKIP LOCKED` gives safe
// multi-worker claiming without adding Redis to the deployment story. If
// throughput ever outgrows this, the queue interface is narrow enough to
// swap behind.

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Retries exhausted; retained for inspection, never re-run automatically.
  DEAD
  CANCELLED
}

model Job {
  id String @id @default(uuid()) @db.Uuid

  /// e.g. `website.scan`, `creative.generate`. Values in src/server/jobs/types.ts.
  type String

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessId  String?   @db.Uuid
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status   JobStatus @default(PENDING)
  /// Higher runs first.
  priority Int       @default(0)

  payload Json
  result  Json?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  /// Earliest time this job may be claimed. Backoff sets it forward.
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  lastError Json?

  /// Caller-supplied key that makes enqueueing idempotent — re-enqueuing the
  /// same logical work (a webhook redelivery, a double-clicked button) returns
  /// the existing job instead of duplicating it.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt, priority])
  @@index([workspaceId, createdAt])
  @@index([businessId, type, createdAt])
  @@map("jobs")
}

// -----------------------------------------------------------------------------
// Provider configuration
// -----------------------------------------------------------------------------
// Which implementation serves each capability, and whether it may cost money.
// A capability with no row here uses its local, free implementation — so the
// application works fully with this table empty, which is the default state.

enum ProviderCapability {
  AI
  IMAGE_GENERATION
  ADVERTISING
  STORAGE
  ANALYTICS
  SEARCH
  EMBEDDING
  /// Fetching public web pages. Free locally; a paid scraping service (for
  /// sites behind bot protection) could slot in behind the same interface.
  WEB_FETCH
}

/// Whether using this provider can result in a bill.
enum ProviderTier {
  /// Runs on this machine. Always available, always free.
  LOCAL_FREE
  /// An external service that charges. Never used unless explicitly enabled.
  EXTERNAL_PAID
}

/// Per-workspace opt-in for a specific provider implementation.
///
/// Enabling a paid provider takes a deliberate act here AND `ZERO_COST_MODE`
/// off AND a non-zero cost ceiling. Three independent switches, because a
/// single misconfiguration should never be able to start a bill.
model ProviderSetting {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  capability  ProviderCapability
  /// Registry key of the implementation, e.g. `ai.local` or `ai.anthropic`.
  providerKey String
  tier        ProviderTier

  enabled Boolean @default(false)

  /// Optional per-provider ceiling, in minor units. Null means "no ceiling of
  /// its own" — the workspace and platform ceilings still apply.
  maxDailyCostCents   Int?
  maxMonthlyCostCents Int?

  enabledBy String?   @db.Uuid
  enabledAt DateTime?

  /// This workspace's own credential for the provider, encrypted at rest by
  /// `encryptSecret` and bound to this workspace and provider key. Null means
  /// the deployment's environment supplies the credential, or nothing does.
  secretCiphertext String?
  /// Last four characters of the key, so an owner can recognise which one is
  /// installed. Never the key itself.
  secretHint       String?
  secretSetBy      String?   @db.Uuid
  secretSetAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, capability, providerKey])
  @@index([workspaceId, capability])
  @@map("provider_settings")
}

// -----------------------------------------------------------------------------
// Cost tracking
// -----------------------------------------------------------------------------

enum CostKind {
  AI_CALL
  IMAGE_GENERATION
  STORAGE
  API_CALL
  EMBEDDING
  SEARCH
  WEB_FETCH
}

/// One row per provider invocation, free or paid.
///
/// Free calls are recorded too, deliberately: "we ran 400 AI calls this month
/// and they cost $0 because they were local" is exactly the fact the cost
/// dashboard needs to show. Append-only.
model CostRecord {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessId  String?   @db.Uuid
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  kind        CostKind
  capability  ProviderCapability
  /// Registry key of the implementation that actually ran.
  providerKey String
  tier        ProviderTier
  model       String?

  /// Units consumed — tokens, images, bytes, requests. Meaning depends on kind.
  units     Int     @default(0)
  unitLabel String?

  /// What it was expected to cost, checked against ceilings BEFORE the call.
  estimatedCostCents Int  @default(0)
  /// What it actually cost, when the provider reports it. Null when unknown —
  /// never back-filled with a guess.
  actualCostCents    Int?

  /// What the call was for, so spend can be attributed to a feature.
  subjectType String?
  subjectId   String?

  succeeded Boolean @default(true)
  errorCode String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([businessId, createdAt])
  @@index([workspaceId, tier, createdAt])
  @@index([capability, createdAt])
  @@map("cost_records")
}

// -----------------------------------------------------------------------------
// Owner-facing activity feed
// -----------------------------------------------------------------------------
// Distinct from `audit_logs` on purpose. The audit log is a complete technical
// record for debugging and accountability. This is the short, plain-language
// story a business owner reads: "Created 3 new ad variations."
//
// Everything here is also in the audit log; not everything in the audit log
// belongs here.

enum ActivitySeverity {
  /// Routine progress. "Created 3 new ad variations."
  INFO
  /// Something worth knowing. "Product price changed; ads updated."
  NOTICE
  /// Needs a decision. "Paused an ad because the product is unavailable."
  ATTENTION
}

model ActivityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  businessId  String   @db.Uuid
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Stable machine key, e.g. `creatives.generated`. Drives the icon.
  kind     String
  severity ActivitySeverity @default(INFO)

  /// One sentence, already written for a non-technical reader. Composed
  /// server-side from verified values — never free text from a model.
  message String

  /// Optional structured detail for a "show me more" expansion.
  detail Json?

  /// True when the owner needs to do something about this.
  needsAttention Boolean   @default(false)
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, needsAttention])
  @@map("activity_events")
}

// =============================================================================
// PHASE 2 — website knowledge
// =============================================================================
// What the scanner learned from a business's own website. Two principles run
// through all of it:
//
//  1. PROVENANCE. Every extracted fact records the URL it came from, how it
//     was extracted, and a confidence. A fact with no source is not a fact.
//  2. HISTORY. Nothing is overwritten. A price change creates a new version
//     row; the old value stays readable, because campaigns may still be
//     carrying it.
// =============================================================================

/// One website per business (for now). Holds crawl-level state that persists
/// between scans, so a rescan can be cheap and can detect change.
model Website {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Normalised origin, e.g. `https://example.com`.
  rootUrl         String
  /// Where the crawl actually landed after redirects, if different.
  resolvedRootUrl String?

  /// Raw robots.txt as fetched, kept so a decision to skip a page is auditable.
  robotsTxt       String?
  robotsFetchedAt DateTime?
  /// Sitemap URLs discovered from robots.txt or the well-known location.
  sitemapUrls     String[]

  /// A hint for extraction strategy, never a hard-coded assumption: the
  /// scanner tries every strategy regardless and uses this only for ordering.
  platformHint String?

  lastScanAt    DateTime?
  lastScanRunId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages    WebsitePage[]
  products Product[]
  scanRuns ScanRun[]

  @@unique([businessId, rootUrl])
  @@index([businessId])
  @@map("websites")
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  /// Finished, but hit a limit before exhausting the site.
  PARTIAL
  FAILED
  CANCELLED
}

/// One scan attempt. Append-only: a rescan creates a new row rather than
/// mutating the last one, which is what makes change detection possible.
model ScanRun {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  websiteId  String?  @db.Uuid
  website    Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  status       ScanStatus @default(QUEUED)
  /// The URL the scan was asked to start from.
  requestedUrl String

  /// Which job is executing this, so the UI can show progress.
  jobId String? @db.Uuid

  startedAt  DateTime?
  finishedAt DateTime?

  // --- Counters, for the progress display and the activity feed -----------
  pagesFetched   Int @default(0)
  pagesSkipped   Int @default(0)
  bytesFetched   Int @default(0)
  productsFound  Int @default(0)
  factsExtracted Int @default(0)

  /// Why the crawl stopped: `completed`, `unreachable` (nothing could be read,
  /// so the run is FAILED rather than empty), `page-limit`, `byte-limit`,
  /// `time-limit`, `cancelled`, or `business-paused`.
  stopReason String?
  /// Structured, user-readable problems encountered (blocked pages, timeouts).
  warnings   Json?
  error      Json?

  /// What changed relative to the previous completed scan of this website.
  changeSummary Json?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([websiteId, createdAt])
  @@index([status])
  @@map("scan_runs")
}

enum PageType {
  HOME
  PRODUCT
  COLLECTION
  ABOUT
  FAQ
  SHIPPING
  RETURNS
  CONTACT
  POLICY
  BLOG
  OTHER
}

/// A fetched page. `contentHash` is what makes rescans cheap and change
/// detection exact.
model WebsitePage {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  websiteId  String   @db.Uuid
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Normalised URL — the dedup key.
  url      String
  /// Where it ended up, if redirected.
  finalUrl String?
  pageType PageType @default(OTHER)

  httpStatus      Int
  title           String?
  metaDescription String?

  /// Visible text, stripped of markup and capped. UNTRUSTED: this is arbitrary
  /// third-party content and is never treated as instruction.
  extractedText  String?

  /// What the page says its own images show, from their alt text.
  ///
  /// Kept out of `extractedText` deliberately: that column is what a visitor
  /// would read, and the listing heuristics count prices and phrases in it.
  /// This is also a different kind of statement — the merchant describing an
  /// image — which is worth labelling when it reaches a writer.
  imageAlts      String[] @default([])
  /// JSON-LD, OpenGraph and microdata found on the page, as extracted.
  structuredData Json?

  /// SHA-256 of the normalised text + structured data. Unchanged hash on a
  /// rescan means nothing to re-extract.
  contentHash String

  /// Links found, for the crawl frontier and for reporting.
  outboundLinkCount Int @default(0)

  fetchedAt   DateTime @default(now())
  firstSeenAt DateTime @default(now())

  @@unique([websiteId, url])
  @@index([businessId, pageType])
  @@index([websiteId, fetchedAt])
  @@map("website_pages")
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

/// A product or service discovered on the website.
///
/// Prices are integer minor units. `costCents` is absent unless the merchant
/// supplied it — the scanner never infers a cost, because margin maths built
/// on a guessed cost would be worse than no margin maths.
model Product {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  websiteId  String   @db.Uuid
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// The product page URL, normalised. The natural key within a website.
  productUrl String
  /// Merchant's own identifier when the page exposes one (SKU, MPN, id).
  externalId String?

  name        String
  description String?

  /// The owner's own words about this product.
  ///
  /// Separate from `description`, which is what the page said and which a
  /// scan overwrites. An owner description has no source URL and is not
  /// evidence about the site, so it is stored apart — and it outranks the
  /// scraped one wherever both exist, because the person selling the thing
  /// knows more about it than its product page does.
  ownerDescription String?
  ownerDescribedAt DateTime?

  priceCents        Int?
  /// A "was" price, only when the page states one explicitly.
  comparePriceCents Int?
  currency          String?
  /// Merchant-supplied only. NEVER inferred.
  costCents         Int?

  availability Availability @default(UNKNOWN)
  category     String?
  brand        String?
  sku          String?
  tags         String[]

  /// Offers/discounts the page states in so many words, e.g. "20% off".
  statedOffers  Json?
  /// Calls to action found on the page, e.g. "Add to cart".
  callsToAction String[]

  /// Hash of the extracted product fields, for change detection.
  contentHash String

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Set when a rescan no longer finds the product. Not deleted: campaigns may
  /// still reference it, and §"do not advertise an unavailable product" needs
  /// to know it went away.
  removedAt   DateTime?

  images              ProductImage[]
  versions            ProductVersion[]
  facts               ProductFact[]
  marketingStrategies MarketingStrategy[]
  offers              Offer[]
  adCopies            AdCopy[]

  @@unique([websiteId, productUrl])
  @@index([businessId, removedAt])
  @@index([websiteId, lastSeenAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceUrl String
  altText   String?
  width     Int?
  height    Int?
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  /// Set once the image has been copied into storage. Phase 4 populates it;
  /// Phase 2 records the source URL only, because downloading every image is
  /// bandwidth the scan does not need to spend.
  storageKey String?

  createdAt DateTime @default(now())

  @@unique([productId, sourceUrl])
  @@index([productId])
  @@map("product_images")
}

/// Every observed change to a product. The row that makes §48/§49 true: a
/// price moving from $9.99 to $11.99 preserves the old value and lets the
/// system flag campaigns carrying stale information.
model ProductVersion {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Monotonic per product, starting at 1 for the first observation.
  versionNumber Int
  /// Full snapshot of the extracted fields at this version.
  snapshot      Json
  /// Which fields differ from the previous version. Empty on version 1.
  changedFields String[]
  /// The scan that observed this version.
  scanRunId     String?  @db.Uuid

  detectedAt DateTime @default(now())

  @@unique([productId, versionNumber])
  @@index([productId, detectedAt])
  @@map("product_versions")
}

/// How a fact was obtained. Ordered by how much it can be trusted: structured
/// data a merchant published deliberately beats a heuristic guess at their
/// markup.
enum ExtractionMethod {
  /// schema.org JSON-LD — published deliberately, highest confidence.
  JSON_LD
  /// OpenGraph / Twitter card meta tags.
  OPENGRAPH
  /// HTML microdata / RDFa attributes.
  MICRODATA
  /// Ordinary HTML elements and attributes (title, h1, itemprop-less markup).
  HTML
  /// Pattern-matched from visible text. Lowest confidence.
  TEXT_PATTERN
  /// Typed in by the merchant inside this application.
  MERCHANT_PROVIDED
}

/// A VERIFIED fact about the business, traceable to a URL.
///
/// Deliberately a different table from anything AI-generated (Phase 3's
/// `ai_inferences`). Nothing in here is a model's opinion; everything has a
/// source URL and an excerpt. The UI renders the two differently, and an
/// inference can never be promoted into this table.
model BusinessFact {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Dotted key, e.g. `business.name`, `contact.email`, `policy.returns`.
  key   String
  value String

  /// Provenance. Not nullable — a fact without a source is not a fact.
  sourceUrl     String
  sourceExcerpt String?
  method        ExtractionMethod
  /// 0..1. Derived from the extraction method and corroboration, never invented.
  confidence    Float

  scanRunId String? @db.Uuid

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([businessId, key, value])
  @@index([businessId, key])
  @@map("business_facts")
}

/// The same, scoped to one product.
model ProductFact {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  key   String
  value String

  sourceUrl     String
  sourceExcerpt String?
  method        ExtractionMethod
  confidence    Float

  scanRunId String? @db.Uuid

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([productId, key, value])
  @@index([productId, key])
  @@map("product_facts")
}

/// A fixed-window rate-limit counter.
///
/// In the database rather than in memory because a serverless deployment has
/// no shared memory between invocations, and in the database rather than Redis
/// because that would be a second datastore — and a paid one — to serve one
/// table. Rows are disposable: losing them re-opens a window, it does not
/// corrupt anything.
model RateLimit {
  /// `<action>:<subject>`, e.g. `login:203.0.113.4` or `scan:<businessId>`.
  key         String   @id
  /// Start of the window this count belongs to, truncated to the window size.
  windowStart DateTime
  count       Int      @default(0)
  /// When this row stops being useful, so housekeeping can delete it.
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

// -----------------------------------------------------------------------------
// Phase 3 — the marketing engine
//
// The organising rule of this section: what a model concluded is kept in
// different tables from what was read off a merchant's own website, and there
// is no operation that moves a row from the second kind to the first. See
// `AiInference` below.
// -----------------------------------------------------------------------------

/// What the engine decided, and on what evidence.
///
/// One row per AI call that produced something durable. `reasoningSummary` is a
/// short explanation meant to be shown to the owner — deliberately NOT stored
/// chain-of-thought, which would be both unreliable and unreadable.
///
/// Every generated artefact points back here, so "why does my ad say that?" is
/// answerable months later, including which provider produced it and whether
/// the output was simulated.
model AiDecision {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// e.g. `business.analyse`, `strategy.generate`, `offer.propose`.
  kind String

  /// What went in, in one line. Not the whole prompt.
  inputSummary     String
  /// Why this came out, in the owner's language.
  reasoningSummary String
  /// The validated payload, kept so a result can be re-rendered or audited.
  output           Json

  /// `low` | `medium` | `high`. How much to trust this.
  uncertainty String @default("medium")

  /// Ids of the verified facts this was built from — the evidence trail.
  factIds String[]

  /// Which implementation produced it, and whether it was a real model.
  providerKey String
  model       String?
  simulated   Boolean @default(true)

  promptTokens       Int?
  completionTokens   Int?
  estimatedCostCents Int  @default(0)

  createdAt DateTime @default(now())

  inferences AiInference[]
  strategies MarketingStrategy[]
  offers     Offer[]
  adCopies   AdCopy[]
  profiles   BusinessProfile[]

  @@index([businessId, createdAt])
  @@index([businessId, kind])
  @@map("ai_decisions")
}

/// The model's standing understanding of a business.
///
/// Distinct from `business_facts`: nothing here is quoted from the website, it
/// is a reading of it. Regenerated wholesale rather than edited, so it always
/// corresponds to one decision.
model BusinessProfile {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  valueProposition String
  brandVoice       String
  /// Words and claims this merchant does not want used. Enforced on ad copy.
  restrictions     String[]

  aiDecisionId String?     @db.Uuid
  aiDecision   AiDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_profiles")
}

enum InferenceKind {
  AUDIENCE_HYPOTHESIS
  MOTIVATION
  OBJECTION
  USE_CASE
  SEASONAL_OPPORTUNITY
}

/// How sure the engine is. Three words, not a number — a decimal here would
/// imply a precision that does not exist.
enum Uncertainty {
  LOW
  MEDIUM
  HIGH
}

/// Everything the model concluded rather than read.
///
/// The counterpart to `business_facts` / `product_facts`, and deliberately a
/// separate table. A fact carries a source URL and an extraction method; an
/// inference carries reasoning and an uncertainty, and can cite the facts it
/// was built from. The UI renders the two differently and nothing promotes an
/// inference into a fact — that separation is the whole point of §"distinguish
/// verified information from AI inference".
model AiInference {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Optional narrower subject, e.g. a product this is about.
  subjectType String?
  subjectId   String? @db.Uuid

  kind      InferenceKind
  statement String
  reasoning String

  uncertainty Uncertainty @default(MEDIUM)

  /// `business_facts` / `product_facts` ids this was reasoned from. May be
  /// empty, which is itself informative: a conclusion drawn from nothing.
  supportingFactIds String[]

  aiDecisionId String?     @db.Uuid
  aiDecision   AiDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId, kind])
  @@index([businessId, createdAt])
  @@map("ai_inferences")
}

enum StrategyAngle {
  PROBLEM_SOLUTION
  BENEFIT
  DEMONSTRATION
  LIFESTYLE
  SEASONAL
  GIFT
  VALUE
  SOCIAL_PROOF
  URGENCY
  EDUCATIONAL
  COMPARISON
}

/// One way of advertising something, with its reasoning exposed.
///
/// Note what is absent: any numeric quality score. A model cannot know in
/// advance which angle will work, and a "0.82" would invite treating a guess
/// as a measurement. What it can offer is a hypothesis, the assumptions behind
/// it, and the variables worth testing — which is what Phase 8's experiments
/// then actually measure.
model MarketingStrategy {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String?  @db.Uuid
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  angle        StrategyAngle
  hypothesis   String
  hook         String
  suggestedCta String

  /// What has to be true for this to work. Stated so it can be checked.
  assumptions      String[]
  /// What an experiment should vary to test it.
  testingVariables String[]

  aiDecisionId String?     @db.Uuid
  aiDecision   AiDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  adCopies AdCopy[]

  @@index([businessId, createdAt])
  @@index([productId])
  @@map("marketing_strategies")
}

enum OfferType {
  PERCENT_OFF
  FIXED_OFF
  BXGY
  BUNDLE
  FREE_SHIPPING
  SEASONAL
}

enum OfferStatus {
  PROPOSED
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

/// Per-business merchant constraints on what may be offered.
///
/// The engine proposes within these and cannot argue with them. Absent a row,
/// the defaults here are deliberately conservative: a modest ceiling, and
/// approval required, so a business that never opens this screen cannot have a
/// discount published on its behalf.
model OfferRules {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  maxDiscountPercent Int  @default(20)
  minDiscountPercent Int  @default(5)
  /// When set, an offer that would take margin below this is never proposed.
  /// Only meaningful where the merchant supplied a cost.
  minMarginPercent   Int?

  allowPercentage   Boolean @default(true)
  allowFixed        Boolean @default(true)
  allowBundles      Boolean @default(false)
  allowFreeShipping Boolean @default(true)
  allowSeasonal     Boolean @default(true)

  /// Whether an offer may become active without a person saying yes.
  allowAutomatic  Boolean @default(false)
  requireApproval Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("offer_rules")
}

/// A proposed or live promotion.
///
/// `marginKnown` is the important column. The engine is forbidden from
/// inventing a cost price, so when the merchant has not supplied one the
/// margin is recorded as *unavailable* rather than estimated — and the UI says
/// so. An invented margin would be a number someone might discount against.
model Offer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String?  @db.Uuid
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  type  OfferType
  /// Percent for PERCENT_OFF, minor units for FIXED_OFF, unused otherwise.
  value Int?

  /// What the customer would pay. Null when it cannot be computed from a
  /// price the website actually states.
  resultingPriceCents Int?

  /// False means "the merchant never told us what this costs them".
  marginKnown          Boolean @default(false)
  estimatedMarginCents Int?

  rationale String
  status    OfferStatus @default(PROPOSED)

  approvedBy String?   @db.Uuid
  approvedAt DateTime?
  startsAt   DateTime?
  endsAt     DateTime?

  aiDecisionId String?     @db.Uuid
  aiDecision   AiDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adCopies AdCopy[]

  @@index([businessId, status])
  @@index([productId])
  @@map("offers")
}

enum AdCopyStatus {
  DRAFT
  APPROVED
  REJECTED
  ARCHIVED
}

/// Ad text for one product, under one strategy.
///
/// Assembled from verified product facts and, where present, an offer that has
/// been approved — never from the model's recollection of the product. The
/// claim checker runs before anything reaches this table.
model AdCopy {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  strategyId String            @db.Uuid
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  offerId String? @db.Uuid
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  primaryText  String
  headline     String
  description  String
  cta          String
  /// e.g. `A`, `B` — which variant of a test this is.
  variantLabel String

  status AdCopyStatus @default(DRAFT)

  aiDecisionId String?     @db.Uuid
  aiDecision   AiDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([productId])
  @@index([strategyId])
  @@map("ad_copies")
}
